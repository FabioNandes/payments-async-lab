# Copie para .env e ajuste. Nunca versione o .env.
# Lido pelo docker-compose.yml (ambiente) e pela suíte (testes).

# URLs do ambiente local
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:9000/app
# O Medusa cria a "Default Publishable API Key" no primeiro boot, com valor diferente a cada
# banco novo. Leia em GET /admin/api-keys ou no admin (Settings → Publishable API Keys).
MEDUSA_PUBLISHABLE_KEY=

# Credenciais do ambiente descartável. Qualquer valor serve; nenhum deles existe fora da sua
# máquina. Para gerar os segredos: openssl rand -hex 16
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=

# Banco (asserções de estado persistido)
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis (event bus BullMQ, workflow engine, cache, locks)
REDIS_PORT=6379
